---
// Páginas locais — mantêm os endereços do site atual (ex.: /agencias-funerarias-lisboa/)
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import AgencyCard from '../components/AgencyCard.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { localPages, agencies, services, funerals } from '../data/site';

export function getStaticPaths() {
  return localPages.map((l) => ({ params: { local: l.slug }, props: { l } }));
}
const { l } = Astro.props;
const here = agencies.filter((a) => l.agencies.includes(a.slug));
const svc = [...funerals.slice(0, 3), ...services.slice(0, 3)];
---
<Base title={`Funerária em ${l.city} — serviço 24 horas`} description={`Funerária Almeida em ${l.city}: funerais, cremação, exumação e trasladação com serviço permanente 24 horas e facilidades de pagamento.`}>
  <PageHero title={`Funerária em ${l.city}`} intro={l.text[0]} crumbs={[{ label: 'Agências', href: '/funerarias/' }]} />
  <section class="section">
    <div class="container split" style="align-items:start">
      <div class="prose reveal">
        {l.text.slice(1).map((p) => <p class="lead">{p}</p>)}
        <h2>Serviços disponíveis em {l.city}</h2>
        <ul class="checklist">
          {svc.map((s) => (
            <li><Icon name="check" /> <a href={'href' in s ? (s as any).href : `/servicos-funerarios/${s.slug}/`}>{s.title}</a></li>
          ))}
        </ul>
      </div>
      <div class="grid" style="gap:1.25rem">{here.map((a) => <AgencyCard agency={a} />)}</div>
    </div>
  </section>
  <section class="section" style="padding-top:0"><div class="container"><CtaBand /></div></section>
</Base>
