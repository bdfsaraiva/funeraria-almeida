---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---
<Base title="Página não encontrada">
  <PageHero title="Página não encontrada" intro="A página que procura mudou de endereço ou já não existe." />
  <section class="section">
    <div class="container narrow">
      <p class="lead">Se precisa de ajuda urgente, ligue-nos a qualquer hora.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={site.phoneMain.href}><Icon name="phone" /> {site.phoneMain.label}</a>
        <a class="btn btn--ghost" href="/">Voltar ao início</a>
      </div>
    </div>
  </section>
</Base>
